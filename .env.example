# latest-plan-20261005. Shell-compatible example; source explicitly with set -a.
# Backend/Live example ports match README. No keys, paid requests or model downloads are supplied.
# Obtain keys and gated-model access yourself; do not publish populated copies.
PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY_FILE=/dev/null
OPENAI_API_KEY_FILE=/dev/null
GEMINI_API_KEY_FILE=/dev/null
# Direct-loopback development only. Configure DEMO_ACCESS_CODE before exposing to a network/proxy.
AISW_LOCAL_ONLY=1
AISW_FOLLOW_PROVIDER=clef
AISW_FOLLOW_CLEF_URL=http://127.0.0.1:8085/v1/systemone
AISW_FOLLOW_CLEF_MODEL=clef
AISW_FOLLOW_CLEF_MODE=choice
AISW_FOLLOW_CLEF_YES_MIN=0.7
AISW_TRACKER_URL=http://127.0.0.1:8090
AISW_TTS_URL=
LIVE_TTS_URL=
LIVE_ENGINE=real
LIVE_UPSTREAM_URL=http://127.0.0.1:8040
LIVE_UPSTREAM_ACCESS_CODE=
# Direct-loopback only until real access codes and allowed origins are configured.
LIVE_ACCESS_CODE=
LIVE_CORS_ORIGINS=http://127.0.0.1:8104
# Separate tracker process: model/dependency paths must be configured as in MODELS.md.
# Both models may share a sufficiently large GPU. Device visibility/VRAM is operator-controlled.
TRACKER_GROUNDER=sam3
TRACKER_GROUNDER_DEVICE=cuda:0
TRACKER_SAM2_DEVICE=cuda:0
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8090
TRACKER_SAM2_COMPILE=image_encoder
# Do not set optional numeric settings to an empty string; leave them unset.
# Separate Clef process: see MODELS.md for actual backbone/adapter paths and memory limits.
CLEF_DEVICE=split
CLEF_PORT=8085
# CLEF_QUANT=fp8dyn only with the documented compatible torchao/CUDA setup.
# CLEF_WEIGHTS points to a pre-merged c checkpoint when using that loading path.
