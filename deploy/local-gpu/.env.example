# Local-GPU deployment environment — standalone Linux + NVIDIA server, loopback only, no external service.
# setup.sh copies this file to <repo root>/.env.local-gpu (git-ignored) and run.sh sources that copy.
# Edit the copy, never this template. Every value here is local and offline-safe: no API keys, no paid
# calls, no model downloads. The backend/Live values are the same ones the repository's .env.example uses.
#
# MODEL_ROOT is an absolute model directory outside this repository by default. Its layout is documented
# in MODELS.md; run.sh derives model paths from it unless you set explicit paths below. setup.sh downloads
# no weights; it only checks out the pinned SAM 2 source there. Keep all weights outside tracked files.
#   $MODEL_ROOT/clef/                        Clef release snapshot (config, tokenizer, joint_head.safetensors,
#                                            joint_head_config.json, backbone *.safetensors)
#   $MODEL_ROOT/clef-ft-20261004c/           team c adapter (adapter/, head.safetensors, joint_head_config.json)
#   $MODEL_ROOT/sam2-src/                    facebookresearch/sam2 checkout at commit 2b90b9f5… (repo root)
#   $MODEL_ROOT/sam2.1_hiera_base_plus.pt    SAM 2.1 checkpoint, sha256 a2345aed…
#   $MODEL_ROOT/hf/                          HF cache holding the grounder weights (SAM 3, or GroundingDINO)
#
# EXAMPLE: MODEL_ROOT=/srv/synoptics-models
MODEL_ROOT="${HOME}/synoptics-models"

# GPUs the Clef decision server may see. run.sh starts it with CLEF_DEVICE=split, which spreads the 27B
# BF16 model (~52 GiB of weights plus activations) over every visible GPU, so name enough memory:
#   0      one 80 GiB GPU, with CLEF_MAX_MEMORY=72GiB (the default below)
#   0,1    two GPUs, e.g. CLEF_MAX_MEMORY=28GiB,28GiB
CLEF_CUDA_VISIBLE_DEVICES=0
# Per-GPU cap for the split loader: "28GiB" for every GPU, or one value per GPU in order.
CLEF_MAX_MEMORY=72GiB

# GPUs the tracker service may see. Inside the service the visible devices are renumbered from zero and
# both models are placed on the first one by default (a 24 GiB card holds the grounder and SAM 2.1).
TRACKER_CUDA_VISIBLE_DEVICES=0
TRACKER_GROUNDER_DEVICE=cuda:0
TRACKER_SAM2_DEVICE=cuda:0

# ---- backend / Live (same values as the repository's .env.example) -------------------------------
PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY_FILE=/dev/null
OPENAI_API_KEY_FILE=/dev/null
GEMINI_API_KEY_FILE=/dev/null
# Direct-loopback development only. Configure DEMO_ACCESS_CODE before exposing to a network/proxy.
AISW_LOCAL_ONLY=1
AISW_FOLLOW_PROVIDER=clef
AISW_FOLLOW_CLEF_URL=http://127.0.0.1:8085/v1/systemone
AISW_FOLLOW_CLEF_MODEL=clef
AISW_FOLLOW_CLEF_MODE=choice
AISW_FOLLOW_CLEF_YES_MIN=0.7
AISW_TRACKER_URL=http://127.0.0.1:8090
# Submission voice path: browser/device speech. Both server voice endpoints stay empty.
AISW_TTS_URL=
LIVE_TTS_URL=
LIVE_ENGINE=real
LIVE_UPSTREAM_URL=http://127.0.0.1:8040
LIVE_UPSTREAM_ACCESS_CODE=
LIVE_ACCESS_CODE=
LIVE_CORS_ORIGINS=http://127.0.0.1:8104

# ---- tracker service -----------------------------------------------------------------------------
TRACKER_GROUNDER=sam3
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8090
TRACKER_SAM2_COMPILE=image_encoder
# Grounder weights must already be in $MODEL_ROOT/hf: offline mode turns a missing checkpoint into a clear
# startup error instead of an (impossible, for gated SAM 3) download. Set 0 only to fetch them yourself.
HF_HUB_OFFLINE=1

# ---- Clef decision server ------------------------------------------------------------------------
CLEF_DEVICE=split
CLEF_PORT=8085

# ---- optional overrides (uncomment only when you need them) --------------------------------------
# Model paths are derived from MODEL_ROOT; an explicit value here wins over the derived one.
#CLEF_MODEL=$MODEL_ROOT/clef
#CLEF_ADAPTER=$MODEL_ROOT/clef-ft-20261004c
# Set CLEF_ADAPTER= (empty) to serve the release head without the team adapter.
#TRACKER_SAM2_SRC=$MODEL_ROOT/sam2-src
#TRACKER_SAM2_CKPT=$MODEL_ROOT/sam2.1_hiera_base_plus.pt
#TRACKER_HF_HOME=$MODEL_ROOT/hf
#TRACKER_BOX_THRESHOLD=0.3
# CLEF_QUANT=fp8dyn needs torchao in .venv-clef and is a separate, optional path (~28.5 GiB of weights).
#CLEF_QUANT=fp8dyn
# CLEF_WEIGHTS points at a backbone with the adapter already merged (tools/clef_ft/merge_ckpt.py); the
# in-server merge is then skipped and, with CLEF_QUANT=fp8dyn, float8 conversion happens while loading.
#CLEF_WEIGHTS=$MODEL_ROOT/clef-merged-20261004c
#PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
